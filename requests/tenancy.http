### 1. Onboard New Tenant Organization
# Creates a new tenant organization in 'pending' status and assigns the creator as 'Owner'.
POST {{host}}/api/v1/tenants/onboard
Authorization: Bearer {{access_token}}
Content-Type: application/json
Accept: application/json

{
  "name": "Acme Innovations Corp",
  "slug": "acme-innovations"
}

> {%
    client.test("Tenant onboarding successful", function() {
        client.assert(response.status === 201, "Expected 201 Created");
        client.assert(response.body.data.id !== undefined, "Tenant ID returned");
        client.assert(response.body.data.status === "pending", "Status is pending");

        // Save created tenant ID for admin approval testing
        client.global.set("target_tenant_id", response.body.data.id);
    });
%}
